{
  "name": "oc-gitignore-guard",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode2 plugin that requires approval for reading or editing files ignored by .gitignore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-gitignore-guard.git"
  },
  "packageManager": "bun@1.4.4",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18",
    "isomorphic-git": "^1.42.5"
  },
  "overrides": {
    "zod@4.1.8": "4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2"
  }
}
